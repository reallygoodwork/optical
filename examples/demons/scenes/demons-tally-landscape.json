    {
      "id": "stats",
      "type": "node",
      "html": "<div class=\"wrap\">\n    <div class=\"stat\" style=\"left:100px\"><div class=\"odo a\"><span class=\"col\"><span class=\"reel\" style=\"animation:roll1 1.4s cubic-bezier(.2,.9,.1,1) 0.6s both\"><span>0</span><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span></span></span><span class=\"col\"><span class=\"reel\" style=\"animation:roll2 1.4s cubic-bezier(.2,.9,.1,1) 0.6799999999999999s both\"><span>0</span><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span></span></span><span class=\"sep\">,</span><span class=\"col\"><span class=\"reel\" style=\"animation:roll4 1.4s cubic-bezier(.2,.9,.1,1) 0.76s both\"><span>0</span><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span></span></span><span class=\"col\"><span class=\"reel\" style=\"animation:roll8 1.4s cubic-bezier(.2,.9,.1,1) 0.84s both\"><span>0</span><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span></span></span><span class=\"col\"><span class=\"reel\" style=\"animation:roll0 1.4s cubic-bezier(.2,.9,.1,1) 0.9199999999999999s both\"><span>0</span><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span></span></span></div><div class=\"lab\" style=\"color:$colors.gold;animation:up .4s ease-out 1.5s both\">assets checked</div></div>\n    <div class=\"stat\" style=\"left:760px\"><div class=\"odo b\"><span class=\"col\"><span class=\"reel\" style=\"animation:roll9 1.4s cubic-bezier(.2,.9,.1,1) 1s both\"><span>0</span><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span></span></span><span class=\"col\"><span class=\"reel\" style=\"animation:roll6 1.4s cubic-bezier(.2,.9,.1,1) 1.08s both\"><span>0</span><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span></span></span><span class=\"sep\">%</span></div><div class=\"lab\" style=\"color:$colors.maya;animation:up .4s ease-out 1.9s both\">on brand first try</div></div>\n    <div class=\"stat\" style=\"left:1320px\"><div class=\"odo c\"><span class=\"col\"><span class=\"reel\" style=\"animation:roll4 1.4s cubic-bezier(.2,.9,.1,1) 1.4s both\"><span>0</span><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span></span></span><span class=\"sep\">,</span><span class=\"col\"><span class=\"reel\" style=\"animation:roll2 1.4s cubic-bezier(.2,.9,.1,1) 1.48s both\"><span>0</span><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span></span></span><span class=\"col\"><span class=\"reel\" style=\"animation:roll0 1.4s cubic-bezier(.2,.9,.1,1) 1.5599999999999998s both\"><span>0</span><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span></span></span><span class=\"col\"><span class=\"reel\" style=\"animation:roll0 1.4s cubic-bezier(.2,.9,.1,1) 1.64s both\"><span>0</span><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span></span></span></div><div class=\"lab\" style=\"color:$colors.candy;animation:up .4s ease-out 2.3s both\">fixes shipped</div></div></div>",
      "css": "\n    .wrap{position:absolute;left:0;top:0;width:1920px;height:1080px;font-family:'Bricolage Grotesque';color:$colors.bone}\n    .stat{position:absolute;top:430px;display:flex;flex-direction:column;gap:10px}\n    .odo{display:flex;height:150px;overflow:hidden;font-size:160px;font-weight:800;line-height:150px;letter-spacing:-0.04em}\n    .col{display:flex;justify-content:center;width:0.6em;height:150px;overflow:hidden}\n    .reel{display:flex;flex-direction:column;align-items:center}\n    .reel span{height:150px;line-height:150px}\n    .sep{height:150px;line-height:150px}\n    .lab{font-family:'JetBrains Mono';font-size:40px}\n    @keyframes up{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0px)}}\n    @keyframes roll0{from{transform:translateY(0px)}to{transform:translateY(-0px)}}\n@keyframes roll1{from{transform:translateY(0px)}to{transform:translateY(-150px)}}\n@keyframes roll2{from{transform:translateY(0px)}to{transform:translateY(-300px)}}\n@keyframes roll3{from{transform:translateY(0px)}to{transform:translateY(-450px)}}\n@keyframes roll4{from{transform:translateY(0px)}to{transform:translateY(-600px)}}\n@keyframes roll5{from{transform:translateY(0px)}to{transform:translateY(-750px)}}\n@keyframes roll6{from{transform:translateY(0px)}to{transform:translateY(-900px)}}\n@keyframes roll7{from{transform:translateY(0px)}to{transform:translateY(-1050px)}}\n@keyframes roll8{from{transform:translateY(0px)}to{transform:translateY(-1200px)}}\n@keyframes roll9{from{transform:translateY(0px)}to{transform:translateY(-1350px)}}\n    .chart{position:absolute;left:780px;top:330px;width:1040px;height:600px;display:flex;align-items:flex-end;gap:26px;border-bottom:4px solid $colors.raised}\n    .bar{width:96px;border-radius:18px 18px 0 0;transform-origin:50% 100%}\n    @keyframes grow{from{transform:scaleY(0)}to{transform:scaleY(1)}}\n  ",
      "end": 4.3,
