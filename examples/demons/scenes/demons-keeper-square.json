    {
      "id": "scanner",
      "type": "node",
      "html": "<div class=\"belt\"><div class=\"scan\"></div><div class=\"beam\"></div>\n    <div class=\"card c0\" style=\"background:$colors.maya;color:$colors.ink\">\n      <div class=\"k\">demons</div>\n      <div class=\"h\">Colour, type and tone, checked.</div>\n      <div class=\"cta \">Summon</div>\n      <div class=\"pill ok\">on brand</div>\n    </div>\n    <div class=\"card c1\" style=\"background:$colors.candy;color:$colors.ink\">\n      <div class=\"k\">demons</div>\n      <div class=\"h\">Every asset, before it ships.</div>\n      <div class=\"cta bad\">Summon</div>\n      <div class=\"pill fix\">fixed: cta colour</div>\n    </div>\n    <div class=\"card c2\" style=\"background:$colors.acid;color:$colors.ink\">\n      <div class=\"k\">demons</div>\n      <div class=\"h\">Summon Keeper in Slack.</div>\n      <div class=\"cta \">Summon</div>\n      <div class=\"pill ok\">on brand</div>\n    </div>\n    <div class=\"card c3\" style=\"background:$colors.gold;color:$colors.ink\">\n      <div class=\"k\">demons</div>\n      <div class=\"h\">The fix, not just the flag.</div>\n      <div class=\"cta bad\">Summon</div>\n      <div class=\"pill fix\">fixed: cta colour</div>\n    </div></div>",
      "css": "\n    .belt{position:absolute;left:0;top:0;width:1080px;height:1080px}\n    .card{position:absolute;top:300px;left:1120px;width:400px;height:460px;border-radius:28px;padding:28px;display:flex;flex-direction:column;gap:14px;\n      box-shadow:0 14px 0 $colors.ink;font-family:'Bricolage Grotesque'}\n    .k{font-family:'JetBrains Mono';font-size:20px;opacity:.7}\n    .h{font-size:52px;font-weight:800;line-height:1;letter-spacing:-0.03em;flex-grow:1}\n    .cta{align-self:flex-start;font-size:26px;font-weight:700;padding:12px 22px;border-radius:999px;background:$colors.ink;color:$colors.bone}\n    .pill{position:absolute;top:-22px;right:20px;font-family:'JetBrains Mono';font-size:20px;padding:8px 16px;border-radius:999px;opacity:0;transform:scale(.4)}\n    .ok{background:$colors.ink;color:$colors.acid}\n    .fix{background:$colors.flame;color:$colors.ink}\n    @keyframes ride{0%{left:1120px;top:300px;transform:rotate(8deg)}35%{left:590px;top:300px;transform:rotate(0deg)}70%{left:590px;top:300px;transform:rotate(0deg)}100%{left:640px;top:1180px;transform:rotate(-14deg)}}\n    @keyframes stamp{0%{opacity:0;transform:scale(.4) rotate(-12deg)}60%{opacity:1;transform:scale(1.15) rotate(4deg)}100%{opacity:1;transform:scale(1) rotate(0deg)}}\n    @keyframes fixcta{0%{background:$colors.sapphire;color:$colors.bone}50%{background:$colors.sapphire;transform:scale(1)}75%{transform:scale(1.15)}100%{background:$colors.flame;color:$colors.ink;transform:scale(1)}}\n    .c0{animation:ride 2.6s cubic-bezier(.65,0,.35,1) 1s both}\n      .c0 .pill{animation:stamp .35s cubic-bezier(.34,1.56,.64,1) 2.05s both}\n      .c0 .bad{animation:fixcta .7s ease-out 1.7s both}\n.c1{animation:ride 2.6s cubic-bezier(.65,0,.35,1) 2.7s both}\n      .c1 .pill{animation:stamp .35s cubic-bezier(.34,1.56,.64,1) 3.75s both}\n      .c1 .bad{animation:fixcta .7s ease-out 3.4000000000000004s both}\n.c2{animation:ride 2.6s cubic-bezier(.65,0,.35,1) 4.4s both}\n      .c2 .pill{animation:stamp .35s cubic-bezier(.34,1.56,.64,1) 5.45s both}\n      .c2 .bad{animation:fixcta .7s ease-out 5.1000000000000005s both}\n.c3{animation:ride 2.6s cubic-bezier(.65,0,.35,1) 6.1s both}\n      .c3 .pill{animation:stamp .35s cubic-bezier(.34,1.56,.64,1) 7.1499999999999995s both}\n      .c3 .bad{animation:fixcta .7s ease-out 6.8s both}\n    .scan{position:absolute;left:560px;top:270px;width:460px;height:520px;border:5px dashed $colors.acid;border-radius:36px}\n    .beam{position:absolute;left:574px;top:280px;width:432px;height:10px;background:$colors.acid;border-radius:10px;animation:beam 8s linear 1s both}\n    @keyframes beam{0%{top:284px}6.25%{top:768px}12.5%{top:284px}18.75%{top:768px}25%{top:284px}31.25%{top:768px}37.5%{top:284px}43.75%{top:768px}50%{top:284px}56.25%{top:768px}62.5%{top:284px}68.75%{top:768px}75%{top:284px}81.25%{top:768px}87.5%{top:284px}93.75%{top:768px}100%{top:284px}}\n  ",
      "start": 0.6,
      "enter": "fade"
    },
