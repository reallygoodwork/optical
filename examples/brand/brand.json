{
  "name": "Lumen",
  "colors": {
    "ink": "#14121F",
    "paper": "#F6F1E9",
    "primary": "#2A1B5C",
    "onPrimary": "#F6F1E9",
    "accent": "#FF6B4A",
    "muted": "#8C86A3"
  },
  "fonts": { "display": "Inter Display", "body": "Inter" },
  "fontFaces": [
    { "family": "Inter", "src": "./fonts/Inter-Regular.otf", "weight": 400 },
    { "family": "Inter", "src": "./fonts/Inter-Bold.otf", "weight": 700 },
    { "family": "Inter Display", "src": "./fonts/InterDisplay-Bold.otf", "weight": 700 }
  ],
  "text": {
    "display": { "font": "Inter Display", "weight": 700, "lineHeight": 1.02, "letterSpacing": -0.02 },
    "body": { "font": "Inter", "weight": 400, "lineHeight": 1.35 },
    "eyebrow": { "font": "Inter", "weight": 700, "uppercase": true, "letterSpacing": 0.12 }
  },
  "assets": { "logo": "./logo.svg", "logoOnDark": "./logo-on-dark.svg" },
  "layout": { "margin": 72 },
  "motion": { "duration": 0.6, "ease": "outCubic" },
  "defaults": { "background": "$colors.paper", "color": "$colors.ink", "font": "Inter" }
}
